---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/home/Hero.astro";
import AboutSection from "../components/home/AboutSection.astro";
import ResilienceSection from "../components/home/ResilienceSection.astro";
import ProductsSection from "../components/home/ProductsSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import Footer from "../components/layout/Footer.astro";

const title = "Increo | Resilient Technology for Unmanned Systems";
const description = "Increo develops the core technology stack that powers unmanned systems, from flight control electronics to secure communications and resilient navigation.";
---

<BaseLayout {title} {description}>
  <Header />
  <main id="main-content">
    <Hero />
    <AboutSection />
    <ResilienceSection />
    <ProductsSection />
    <ContactSection />
  </main>
  <Footer />
  <script>
    import "../scripts/site";
  </script>
</BaseLayout>
