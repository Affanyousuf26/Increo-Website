---
interface Props {
  index: string;
  label: string;
  title: string;
  headingId: string;
}

const { index, label, title, headingId } = Astro.props;
---

<div class="section-heading" data-reveal>
  <div class="section-heading__meta">
    <span>{index}</span>
    <span>{label}</span>
  </div>
  <h2 id={headingId}>{title}</h2>
</div>
