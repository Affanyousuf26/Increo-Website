---
const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "";
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="technical-grid" aria-hidden="true"></div>
  <div class="shell contact__grid">
    <div class="contact__intro" data-reveal>
      <p class="section-index">05 / CONTACT</p>
      <h2 id="contact-heading">Let’s build<br /><em>what’s next.</em></h2>
      <p>Connect with Increo to discuss unmanned systems, technology collaboration, strategic partnerships, or business opportunities.</p>
      <div class="contact__signal" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>

    <form class="inquiry-form" action={formEndpoint || undefined} method="POST" data-contact-form data-endpoint={formEndpoint} novalidate>
      <div class="form-row">
        <div class="field">
          <label for="full-name">Full name <span>*</span></label>
          <input id="full-name" name="name" type="text" autocomplete="name" required maxlength="100" />
          <span class="field-error" data-error-for="full-name"></span>
        </div>
        <div class="field">
          <label for="organization">Organization</label>
          <input id="organization" name="organization" type="text" autocomplete="organization" maxlength="120" />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="email">Business email <span>*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
          <span class="field-error" data-error-for="email"></span>
        </div>
        <div class="field">
          <label for="inquiry-type">Inquiry type <span>*</span></label>
          <select id="inquiry-type" name="inquiryType" required>
            <option value="">Select inquiry</option>
            <option>Product Inquiry</option>
            <option>Strategic Partnership</option>
            <option>Investor Relations</option>
            <option>General Inquiry</option>
          </select>
          <span class="field-error" data-error-for="inquiry-type"></span>
        </div>
      </div>
      <div class="field">
        <label for="message">Message <span>*</span></label>
        <textarea id="message" name="message" rows="4" required minlength="20" maxlength="2000"></textarea>
        <span class="field-error" data-error-for="message"></span>
      </div>
      <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form-footer">
        <p>By submitting, you acknowledge our <a href={`${import.meta.env.BASE_URL}privacy/`}>privacy notice</a>.</p>
        <button class="button button--primary" type="submit">Send inquiry <span>↗</span></button>
      </div>
      <p class="form-status" role="status" aria-live="polite" data-form-status>{!formEndpoint ? "Form preview only — Formspree endpoint requires configuration." : ""}</p>
    </form>
  </div>
</section>
